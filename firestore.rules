rules_version = '2';

// Browser access goes through the authenticated, authorized Admin API.
// Deploy at the verified v2 cutover, after preserving the legacy snapshot.
service cloud.firestore {
  match /databases/{database}/documents {

    match /apps/alabama-wholesale/{document=**} {
      allow read, write: if false;
    }

    // Everything else is denied by default.
  }
}
